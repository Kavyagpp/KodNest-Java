public class Inventory {
    public static void main(String[] args) {
        // Write your code here.
        int marks[] = {70, 80, 60, 90, 50};
        int total = 0;
        double average = 0;
        for(int i = 0; i <= marks.length - 1; i++) {
            total = total + marks[i];
            average = total / 5;
        }
        System.out.println("Total: " + total);
        System.out.println("Average: " + average);
    }
}
